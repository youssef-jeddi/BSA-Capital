# Copy to .env and fill in. Never commit the real file (.gitignore covers it).
#
# Hackathon master account — our credential issuer on XRPL Devnet.
# Generate and fund it with:  node scripts/10-master-account.mjs
MASTER_ADDRESS=
MASTER_SEED=

# Which verifier the Identity tab uses. Default (unset) = the EU reference
# verifier directly: no auth, nothing to provision. Set to `edelid` to go through
# the Edel-ID gateway instead, which also needs the four EDEL_* values below.
VERIFY_PROVIDER=
EUDI_VERIFIER_URL=https://verifier-backend.eudiw.dev
EUDI_INTENDED_USE_ID=TEST-01
# direct_post (default) = plain form POST, widest wallet support.
# direct_post.jwt = wallet must JARM-encrypt its response; many wallets cannot,
# and they fail with an opaque "sharing failed" + HTTP 400 on submission.
EUDI_RESPONSE_MODE=direct_post
# Deep-link scheme. EUDI reference wallet also accepts eudi-openid4vp,
# mdoc-openid4vp, haip-vp. Other wallets register their own.
EUDI_SCHEME=openid4vp

# Edel-ID Verifier API (EUDI flow). Client credentials come from
# https://portal.edel-id.app → API Keys. Read only in Node, never bundled.
EDEL_AUTH_URL=https://auth.edel-id.app
EDEL_API_URL=https://api.edel-id.app
EDEL_CLIENT_ID=
EDEL_CLIENT_SECRET=
